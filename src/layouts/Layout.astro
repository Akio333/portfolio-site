---
import "../styles/global.css";
import PostHog from "../components/posthog.astro";
import { ClientRouter } from "astro:transitions";
import { highlightJson, profile, type PortfolioNode } from "../lib/portfolio";

interface Props {
  node: PortfolioNode;
  nodes: PortfolioNode[];
}

const { node, nodes } = Astro.props;
const image = "/images/og-image.png";
const site = Astro.site || Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const posthogEnabled = Boolean(import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN);
const pathParts = node.jcrPath.split("/").slice(1);
const current = nodes.find((n) => n.kind === "job");
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1E2330" />
    <meta name="darkreader-lock" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <ClientRouter />
    {posthogEnabled && <PostHog />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{node.title}</title>
    <meta name="description" content={node.description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={node.title} />
    <meta property="og:description" content={node.description} />
    <meta property="og:image" content={new URL(image, site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, AEM full-stack developer`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={node.title} />
    <meta name="twitter:description" content={node.description} />
    <meta name="twitter:image" content={new URL(image, site)} />
    <meta name="twitter:image:alt" content={`${profile.name}, AEM full-stack developer`} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="ide">
      <header class="ide-top">
        <a class="ide-who" href="/"><strong>{profile.name}</strong><span>{profile.role}</span></a>
        <p class="ide-path" aria-label="Content path">
          {pathParts.map((part) => <><i>/</i>{part}</>)}
        </p>
      </header>

      <div class="ide-main">
        <nav class="ide-tree" aria-label="Content tree">
          <ul id="ide-tree">
            <li class="ide-root">{profile.root}</li>
            {nodes.map((n) => (
              <li>
                <a
                  class:list={["ide-node", { parent: n.parent }]}
                  href={n.href}
                  style={`--d:${n.depth}`}
                  aria-current={n.href === node.href ? "page" : undefined}
                  data-node
                >{n.name}</a>
              </li>
            ))}
          </ul>
        </nav>

        <main class="ide-editor" id="content" tabindex="-1">
          <div class="ide-tabs" role="tablist" aria-label="View">
            <button type="button" class="ide-tab" role="tab" id="tab-preview" aria-controls="pane-preview" aria-selected="true" data-tab="preview">Preview</button>
            <button type="button" class="ide-tab" role="tab" id="tab-json" aria-controls="pane-json" aria-selected="false" tabindex="-1" data-tab="json">{node.name}.model.json</button>
          </div>
          <div class="ide-pane" id="pane-preview" role="tabpanel" aria-labelledby="tab-preview">
            <slot />
          </div>
          <div class="ide-pane" id="pane-json" role="tabpanel" aria-labelledby="tab-json" hidden>
            <pre class="code" set:html={highlightJson(node.model)} />
          </div>
        </main>
      </div>

      <footer class="ide-status">
        {current && current.kind === "job" && <span class="now">{current.job.data.role.replace(/ \(.*\)$/, "")}, {current.job.data.company}</span>}
        <span>{profile.location}</span>
        <span>{profile.yearsOnAem} years on AEM</span>
        <button type="button" data-copy-email={profile.email}>Copy email</button>
      </footer>
    </div>

    <script>
      import { navigate } from "astro:transitions/client";
      import "../scripts/extensionVersions";

      const TAB_KEY = "ide-tab";
      let tab = "preview";
      try {
        if (sessionStorage.getItem(TAB_KEY) === "json") tab = "json";
      } catch {}
      let focusTreeAfterLoad = false;
      let cleanup = () => {};

      const applyTab = (doc: Document) => {
        doc.querySelectorAll<HTMLButtonElement>(".ide-tab").forEach((button) => {
          const selected = button.dataset.tab === tab;
          button.setAttribute("aria-selected", String(selected));
          button.tabIndex = selected ? 0 : -1;
        });
        doc.querySelector<HTMLElement>("#pane-preview")!.hidden = tab !== "preview";
        doc.querySelector<HTMLElement>("#pane-json")!.hidden = tab !== "json";
      };

      const setTab = (next: string) => {
        tab = next;
        try {
          sessionStorage.setItem(TAB_KEY, tab);
        } catch {}
        applyTab(document);
      };

      document.addEventListener("astro:before-swap", (event) => {
        cleanup();
        const doc = (event as Event & { newDocument: Document }).newDocument;
        doc.documentElement.classList.add("js");
        applyTab(doc);
      });

      document.addEventListener("astro:page-load", () => {
        const controller = new AbortController();
        const { signal } = controller;
        cleanup = () => controller.abort();
        applyTab(document);

        const tree = document.querySelector<HTMLElement>(".ide-tree")!;
        const nodeLinks = Array.from(tree.querySelectorAll<HTMLAnchorElement>("[data-node]"));
        const selected = tree.querySelector<HTMLAnchorElement>('[aria-current="page"]');

        // In the horizontal (mobile) tree, keep the open node in view.
        if (selected && tree.scrollWidth > tree.clientWidth) {
          tree.scrollLeft = selected.offsetLeft - (tree.clientWidth - selected.offsetWidth) / 2;
        }
        if (focusTreeAfterLoad) selected?.focus();
        focusTreeAfterLoad = false;

        tree.addEventListener("keydown", (event) => {
          if (!["ArrowDown", "ArrowUp", "ArrowLeft", "ArrowRight"].includes(event.key)) return;
          const index = nodeLinks.indexOf(document.activeElement as HTMLAnchorElement);
          if (index === -1) return;
          event.preventDefault();
          const step = event.key === "ArrowDown" || event.key === "ArrowRight" ? 1 : -1;
          const next = nodeLinks[(index + step + nodeLinks.length) % nodeLinks.length];
          focusTreeAfterLoad = true;
          navigate(next.href);
        }, { signal });

        const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".ide-tab"));
        tabs.forEach((button) => {
          button.addEventListener("click", () => setTab(button.dataset.tab!), { signal });
          button.addEventListener("keydown", (event) => {
            if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
            event.preventDefault();
            const other = tabs.find((t) => t !== button)!;
            setTab(other.dataset.tab!);
            other.focus();
          }, { signal });
        });

        document.addEventListener("click", async (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const copy = target?.closest<HTMLButtonElement>("[data-copy-email]");
          if (copy) {
            const email = copy.dataset.copyEmail!;
            try {
              await navigator.clipboard.writeText(email);
              copy.textContent = "Copied";
              setTimeout(() => { copy.textContent = "Copy email"; }, 1800);
            } catch {
              // Clipboard blocked: show and select the address so it can be copied by hand.
              const address = document.querySelector("[data-email]");
              if (address) {
                getSelection()?.selectAllChildren(address);
                copy.textContent = "Email selected";
                setTimeout(() => { copy.textContent = "Copy email"; }, 1800);
              } else {
                copy.textContent = email;
                getSelection()?.selectAllChildren(copy);
              }
            }
            return;
          }

          const link = target?.closest<HTMLAnchorElement>("a[data-ext-title]");
          const analytics = (window as Window & {
            posthog?: { capture: (name: string, properties: Record<string, string>) => void };
          }).posthog;
          if (link) {
            analytics?.capture("extension_marketplace_clicked", {
              extension_title: link.dataset.extTitle!,
              page: window.location.pathname,
            });
          }
        }, { signal });
      });
    </script>
  </body>
</html>
