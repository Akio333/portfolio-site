---
import { Image } from "astro:assets";
import photo from "../../public/images/developer-portrait.webp";
import Layout from "../layouts/Layout.astro";
import ProjectList from "../components/ProjectList.astro";
import { getCollection } from "astro:content";
const extensions = await getCollection("extensions");
---

<Layout
  title="Suyog Mule | AEM & Full-stack developer"
  description="Suyog Mule architects enterprise AEM platforms and builds full-stack products with React, TypeScript, and Java."
>
  <section class="hero wrap">
    <div class="hero-copy enter">
      <p class="availability"><i></i> Based in Pune · Open to ambitious work</p>
      <h1>
        I architect <span>AEM systems</span> built to scale.
      </h1>
      <div class="hero-summary">
        <p>
          Senior full-stack developer working across enterprise content,
          frontend architecture, and cloud delivery.
        </p>
        <a class="button" href="#selected-work"
          >See the work <span aria-hidden="true">↓</span></a
        >
      </div>
    </div>
    <div class="portrait-scene enter" aria-label="Portrait of Suyog Mule">
      <span class="portrait-code" aria-hidden="true">AEM / 01</span>
      <figure class="portrait-card" data-tilt>
        <div class="portrait-image">
          <Image
            src={photo}
            widths={[320, 480, 640, 960]}
            sizes="(max-width: 767px) 90vw, 460px"
            quality={80}
            alt="Suyog Mule"
            width={640}
            fetchpriority="high"
            loading="eager"
          />
        </div><figcaption>
          <span>Suyog Mule</span><span>Senior AEM architect · Full-stack developer</span>
        </figcaption>
      </figure><a class="portrait-about" href="/contact"
        >About me <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
  <aside class="proof-strip wrap" aria-label="Career highlights">
    <div><strong>5+</strong><span>years building enterprise platforms</span></div>
    <div><strong>40+</strong><span>accessible AEM components shipped</span></div>
    <div><strong>8+</strong><span>tenants on one frontend system</span></div>
    <div><strong>02</strong><span>open-source VS Code extensions</span></div>
  </aside>
  <section id="selected-work" class="section wrap">
    <div class="section-heading" data-reveal>
      <h2>Selected work</h2><p>
        Enterprise platforms where architecture, authoring, and frontend craft
        have to work as one.
      </p>
    </div><ProjectList />
  </section>
  <section class="about-section wrap" data-reveal>
    <div>
      <span class="section-number">02 / Approach</span><h2>
        I build the system behind the screen.
      </h2><a class="text-link" href="/experience">Read my experience ↗</a
      >
    </div><div class="about-copy">
      <p>
        I move between AEM architecture, Java services, React interfaces, and
        production operations. That range helps me solve the whole problem,
        not one isolated layer.
      </p><p>
        My work spans insurance, banking, and investment platforms. I care
        about clean boundaries, accessible interfaces, and code another
        developer can change without guesswork.
      </p><div class="skills-list">
        <span>Adobe Experience Manager</span><span>React & TypeScript</span
        ><span>Java & HTL</span><span>GraphQL</span><span
          >Web accessibility</span
        >
      </div>
    </div>
  </section>
  <section class="tools-section wrap">
    <div class="section-heading" data-reveal>
      <h2>Tools I wanted to exist</h2><p>
        Open-source VS Code extensions built around recurring AEM work.
      </p>
    </div><div class="tools-grid">
      {
        extensions.map((extension, i) => (
          <article class="tool" data-reveal>
            <>
              <span class="tool-glyph" aria-hidden="true">
                {i === 0 ? "{ }" : "↥"}
              </span>
              <span
                class="extension-version"
                data-extension-version
                data-marketplace-id={extension.data.marketplaceId}
                data-github-repo={extension.data.githubRepo}
              >
                {extension.data.version}
              </span>
              <h3>{extension.data.title}</h3>
              <p>
                {i === 0
                  ? "AEM development utilities, right inside VS Code."
                  : "Install multiple AEM packages without the repetitive clicks."}
              </p>
              <div class="tool-links">
                <>
                  <a
                    class="ext-marketplace-link"
                    data-ext-title={extension.data.title}
                    href={extension.data.marketplaceUrl}
                  >
                    Get the extension ↗
                  </a>
                  <a href={extension.data.githubUrl}>Source ↗</a>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="contact-banner wrap" data-reveal>
    <span class="section-number">04 / Contact</span><a
      href="mailto:smulye10@gmail.com">Have a hard problem?<br />Bring it over.<span aria-hidden="true">↗</span></a
    >
  </section>
  <script>
    import "../scripts/extensionVersions";
  </script>
</Layout>
