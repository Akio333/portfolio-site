---
import { Image } from "astro:assets";
import photo from "../../public/images/developer-portrait.webp";
import Layout from "../layouts/Layout.astro";
import ProjectList from "../components/ProjectList.astro";
import { getCollection } from "astro:content";
const extensions = await getCollection("extensions");
---
<Layout title="Suyog Mule | AEM & Full-stack developer" description="Suyog Mule architects enterprise AEM platforms and builds full-stack products with React, TypeScript, and Java.">
  <section class="hero wrap">
    <div class="hero-copy enter">
      <h1>AEM architect.<br /><span>Full-stack maker.</span></h1>
      <a class="button" href="#selected-work">Explore my work <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-art enter" data-tilt aria-hidden="true">
      <img src="/images/suyog-sculpture.webp" alt="" width="1024" height="1024" fetchpriority="high" />
    </div>
  </section>
  <section id="selected-work" class="section wrap">
    <div class="section-heading" data-reveal><h2>Selected work<span class="accent">.</span></h2><a class="text-link" href="/projects">All work <span aria-hidden="true">↗</span></a></div>
    <ProjectList />
  </section>
  <section class="about-section wrap" data-reveal>
    <a href="/contact" class="about-photo" aria-label="About Suyog Mule"><Image src={photo} widths={[240, 400, 640]} sizes="(max-width: 767px) 40vw, 280px" alt="Suyog Mule" width={400} loading="lazy" /></a>
    <div class="about-statement"><h2>Good interfaces start<br />with good engineering.</h2><p>I’m Suyog. I build AEM platforms, React interfaces, and tools that make a developer’s day easier.</p><a class="text-link" href="/experience">My experience <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="tools-section wrap">
    <div class="section-heading" data-reveal><h2>Made for developers<span class="accent">.</span></h2></div>
    <div class="tools-list">{extensions.map((extension, i) => (
      <article class="tool" data-reveal>
        <span class="tool-glyph" aria-hidden="true">{i === 0 ? "{ }" : "[+]"}</span>
        <h3><a class="ext-marketplace-link" data-ext-title={extension.data.title} href={extension.data.marketplaceUrl}>{extension.data.title}</a></h3>
        <div class="tool-links"><a data-ext-title={extension.data.title} href={extension.data.marketplaceUrl} aria-label={`Install ${extension.data.title}`}>Install ↗</a><a href={extension.data.githubUrl} aria-label={`Source code for ${extension.data.title}`}>GitHub ↗</a></div>
      </article>
    ))}</div>
  </section>
  <section class="contact-banner wrap" data-reveal><a href="mailto:smulye10@gmail.com">Let’s build<br />something good.<span aria-hidden="true">↗</span></a></section>
</Layout>
