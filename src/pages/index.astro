---
import { Image } from "astro:assets";
import photo from "../../public/images/developer-portrait.webp";
import Layout from "../layouts/Layout.astro";
import ProjectList from "../components/ProjectList.astro";
import { getCollection } from "astro:content";
const extensions = await getCollection("extensions");
---

<Layout
  title="Suyog Mule | AEM & Full-stack developer"
  description="I'm Suyog, a full-stack developer working with Adobe Experience Manager, React, and Java. Explore my work for Oona, Chase, and Vanguard."
>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow enter">
        Hey, I'm Suyog. <span class="hello">↗</span>
      </p><h1 class="enter">
        Built with care.<br /><span>Made to work.</span>
      </h1><p class="hero-description enter">
        Full-stack developer turning complex content systems into websites
        people enjoy using.
      </p><a class="button enter" href="#selected-work"
        >A few things I've built <span aria-hidden="true">↘</span></a
      >
    </div>
    <div class="portrait-scene enter">
      <figure class="portrait-card" data-tilt>
        <div class="portrait-image">
          <Image
            src={photo}
            widths={[320, 480, 640, 960]}
            sizes="(max-width: 767px) 90vw, 460px"
            quality={80}
            alt="Suyog Mule"
            width={640}
            fetchpriority="high"
            loading="eager"
          />
        </div><figcaption>
          <span>Suyog Mule</span><span>AEM & full-stack developer</span>
        </figcaption>
      </figure><span class="portrait-note"
        >a little about me <span aria-hidden="true">⤴</span></span
      ><a class="portrait-about" href="/contact" aria-label="More about Suyog"
        >↗</a
      >
    </div>
  </section>
  <div class="intro-strip wrap">
    <p>Currently building at <strong>ITC Infotech</strong></p><p>
      Previously <strong>Capgemini</strong>
    </p><a href="/experience"
      >The story so far <span aria-hidden="true">↗</span></a
    >
  </div>
  <section id="selected-work" class="section wrap">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Selected work</p><h2>
        Real problems.<br />Thoughtful solutions.
      </h2>
    </div><ProjectList />
  </section>
  <section class="about-section wrap" data-reveal>
    <div>
      <p class="eyebrow">How I work</p><h2>
        The details make<br />the difference.
      </h2><a class="text-link" href="/experience">More about my experience ↗</a
      >
    </div><div class="about-copy">
      <p>
        I work across the whole stack, from the AEM components an author uses
        every day to the React interfaces their customers see.
      </p><p>
        My work has taken me through investment platforms, banking, and
        insurance. Different problems, same priorities: clear architecture,
        accessible interfaces, and code the next developer can understand.
      </p><div class="skills-list">
        <span>Adobe Experience Manager</span><span>React & TypeScript</span
        ><span>Java & HTL</span><span>GraphQL</span><span
          >Web accessibility</span
        >
      </div>
    </div>
  </section>
  <section class="tools-section wrap">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Made on the side</p><h2>
        Less repetition.<br />More building.
      </h2><p>
        Small, open-source tools for the AEM tasks I kept doing by hand.
      </p>
    </div><div class="tools-grid">
      {
        extensions.map((extension, i) => (
          <article class="tool" data-reveal>
            <>
              <span class="tool-glyph" aria-hidden="true">
                {i === 0 ? "{ }" : "↥"}
              </span>
              <span
                class="extension-version"
                data-extension-version
                data-marketplace-id={extension.data.marketplaceId}
                data-github-repo={extension.data.githubRepo}
              >
                {extension.data.version}
              </span>
              <h3>{extension.data.title}</h3>
              <p>
                {i === 0
                  ? "AEM development utilities, right inside VS Code."
                  : "Install multiple AEM packages without the repetitive clicks."}
              </p>
              <div class="tool-links">
                <>
                  <a
                    class="ext-marketplace-link"
                    data-ext-title={extension.data.title}
                    href={extension.data.marketplaceUrl}
                  >
                    Get the extension ↗
                  </a>
                  <a href={extension.data.githubUrl}>Source ↗</a>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="contact-banner wrap" data-reveal>
    <p class="eyebrow">Have something in mind?</p><a
      href="mailto:smulye10@gmail.com"
      >Let's make it work.<span aria-hidden="true">↗</span></a
    ><p>A project, a role, or a good conversation. My inbox is open.</p>
  </section>
  <script>
    import "../scripts/extensionVersions";
  </script>
</Layout>
