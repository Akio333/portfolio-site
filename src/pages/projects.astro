  </section>
  <section class="wrap projects-page" aria-label="Projects">
    <ProjectList detailed />
  </section>
  <section class="contact-banner wrap" data-reveal>
    <span class="section-number">Next / Contact</span><a href="mailto:smulye10@gmail.com"
      >Let's work through it.<span aria-hidden="true">↗</span></a>
  </section>
