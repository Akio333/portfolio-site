---
import Layout from "../layouts/Layout.astro";
import ProjectList from "../components/ProjectList.astro";
---

<Layout
  title="Selected work | Suyog Mule"
  description="A selection of my AEM and full-stack development projects for Oona Insurance, Chase, and Vanguard."
>
  <section class="page-heading wrap">
    <h1 class="enter">Selected work<span class="accent">.</span></h1>
  </section>
  <section class="wrap projects-page" aria-label="Projects">
    <ProjectList detailed />
  </section>
  <section class="contact-cta wrap" aria-labelledby="project-contact-title" data-reveal>
    <h2 id="project-contact-title">Need help with a complex AEM platform<span class="accent">?</span></h2>
    <p>Tell me what you're trying to solve.</p>
    <a class="email-link" href="mailto:smulye10@gmail.com">smulye10@gmail.com</a>
  </section>
</Layout>
