---
import Layout from "../layouts/Layout.astro";
import ProjectList from "../components/ProjectList.astro";
---

<Layout
  title="Selected work | Suyog Mule"
  description="A selection of my AEM and full-stack development projects for Oona Insurance, Chase, and Vanguard."
>
  <section class="page-heading wrap">
    <p class="eyebrow enter">Selected work</p><h1 class="enter">
      Behind the build.
    </h1><p class="enter">
      Content platforms, frontend systems, and the details that make them work.
      Here's where I've put my time.
    </p>
  </section>
  <section class="wrap projects-page" aria-label="Projects">
    <ProjectList detailed />
  </section>
  <section class="contact-banner wrap" data-reveal>
    <p class="eyebrow">Your project could be next</p><a
      href="mailto:smulye10@gmail.com"
      >Let's talk.<span aria-hidden="true">↗</span></a
    >
  </section>
</Layout>
