---
import { Image } from "astro:assets";
import photo from "../../public/images/developer-portrait.webp";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About & contact | Suyog Mule"
  description="I'm Suyog, an AEM and full-stack developer based in Pune. Get in touch about a project, a role, or open-source development."
>
  <section class="page-heading wrap">
    <span class="page-index enter">03 / About</span><h1 class="enter">
      Clear thinking.<br />Clean execution.
    </h1><p class="enter">I build enterprise web systems, untangle legacy code, and help teams ship with confidence.</p>
  </section>
  <section class="contact-about wrap">
    <figure class="contact-portrait" data-reveal>
      <Image
        src={photo}
        widths={[320, 480, 640, 960]}
        sizes="(max-width: 767px) 90vw, 460px"
        quality={80}
        alt="Suyog Mule"
        width={640}
      /><figcaption>Suyog Mule · Pune, India</figcaption>
    </figure><div class="contact-bio" data-reveal>
      <h2>I'm Suyog Mule.</h2><p>
        I'm a full-stack developer based in Pune, working with Adobe Experience
        Manager, React, and Java.
      </p><p>
        Since 2021, I've worked on websites and content platforms for Vanguard,
        Chase, and Oona Insurance. These days, I'm at ITC Infotech, building AEM
        architecture and React tools for insurance teams.
      </p><p>
        I also make open-source VS Code extensions for AEM developers. They
        usually start with a small frustration in my own workflow.
      </p><a class="text-link" href="/projects">Take a look at my work ↗</a>
    </div>
  </section>
  <section class="contact-details wrap" data-reveal>
    <span class="section-number">Direct line</span><h2>
      Tell me what you're<br />trying to solve.
    </h2><a class="email-link" href="mailto:smulye10@gmail.com"
      >smulye10@gmail.com ↗</a
    ><div class="social-list">
      <a href="https://www.linkedin.com/in/akio333/">LinkedIn <span>↗</span></a
      ><a href="https://github.com/Akio333">GitHub <span>↗</span></a><a
        href="https://marketplace.visualstudio.com/publishers/Akio333"
        >VS Code Marketplace <span>↗</span></a
      >
    </div>
  </section>
</Layout>
