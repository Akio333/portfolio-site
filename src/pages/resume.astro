---
import Layout from "../layouts/Layout.astro";

const title = "Suyog Mule - Resume | AEM Full-Stack Developer";
const description =
  "Professional resume of Suyog Mule, AEM Full-Stack Developer.";
---

<Layout title={title} description={description}>
  <section
    class="resume-page max-w-[1000px] mx-auto px-6 py-16 md:py-24 space-y-16"
  >
    <!-- Header -->
    <div class="text-center space-y-4 relative">
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-[var(--text)]"
      >
        SUYOG MULE
      </h1>
      <p
        class="text-[var(--accent)] font-display font-semibold text-lg md:text-xl tracking-wider"
      >
        AEM full-stack developer | Cloud operations | AI-assisted modernization
      </p>
      <div
        class="flex flex-wrap justify-center gap-4 text-sm text-[var(--muted)] font-sans"
      >
        <span>Pune, Maharashtra</span>
        <span class="hidden md:inline">&bull;</span>
        <span>smulye10@gmail.com</span>
        <span class="hidden md:inline">&bull;</span>
        <span>+91 88881 86744</span>
        <span class="hidden md:inline">&bull;</span>
        <a
          href="https://linkedin.com/in/akio333"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--accent)] transition-colors"
          >linkedin.com/in/akio333</a
        >
      </div>
    </div>

    <!-- Professional Summary -->
    <div
      class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-colors duration-300"
    >
      <h2
        class="text-2xl font-display font-bold text-[var(--text)] mb-4 flex items-center gap-3"
      >
        Professional summary
      </h2>
      <p class="text-[var(--muted)] leading-relaxed text-body-md">
        Senior AEM full-stack developer with 5.5 years building React,
        TypeScript, Java, and AEM systems in cloud and on-premise environments.
        Owns technical decisions for AEM Cloud Operations and guides a 3-5
        person engineering team. Recent work reduced CSS bundle size by 40%,
        data over-fetching by 70%, and support queries by 60%. Uses GitHub
        Copilot for code upgrades and refactoring. Focused on accessible
        interfaces, maintainable architecture, and direct client collaboration.
      </p>
    </div>

    <!-- Core Technical Skills -->
    <div
      class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-colors duration-300"
    >
      <h2
        class="text-2xl font-display font-bold text-[var(--text)] mb-6 flex items-center gap-3"
      >
        Core technical skills
      </h2>
      <div class="space-y-4">
        <div>
          <span class="font-bold text-[var(--text)]"
            >AEM & Content Management:</span
          >
          <span class="text-[var(--muted)] ml-2"
            >AEM as a Cloud Service (AEMaaCS), AEM 6.5, Touch UI, Multi-Site
            Manager (MSM), Digital Asset Management (DAM), Content Fragments,
            Experience Fragments</span
          >
        </div>
        <div>
          <span class="font-bold text-[var(--text)]"
            >Backend & Architecture:</span
          >
          <span class="text-[var(--muted)] ml-2"
            >Java, J2EE, OSGi (Declarative Services), Apache Sling, JCR (Apache
            Oak), HTL/Sightly, Sling Models</span
          >
        </div>
        <div>
          <span class="font-bold text-[var(--text)]">Frontend Development:</span
          >
          <span class="text-[var(--muted)] ml-2"
            >React, TypeScript, JavaScript (ES6+), Angular, HTML5, CSS3,
            SASS/SCSS, Material UI, Bootstrap, jQuery, Storybook</span
          >
        </div>
        <div>
          <span class="font-bold text-[var(--text)]"
            >Integrations & DevOps:</span
          >
          <span class="text-[var(--muted)] ml-2"
            >Adobe Target, Adobe Analytics, Dispatcher Configuration, AWS,
            Maven, CI/CD (Jenkins, GitHub Actions)</span
          >
        </div>
        <div>
          <span class="font-bold text-[var(--text)]"
            >AI & Developer Tooling:</span
          >
          <span class="text-[var(--muted)] ml-2"
            >GitHub Copilot, Generative AI for Code Refactoring & Legacy
            Upgrades, Git, Git Submodules, VS Code, IntelliJ IDEA, WebStorm</span
          >
        </div>
        <div>
          <span class="font-bold text-[var(--text)]">Testing & Quality:</span>
          <span class="text-[var(--muted)] ml-2"
            >Jest, Mockito, Percy, BrowserStack, Unit & Regression Testing</span
          >
        </div>
        <div>
          <span class="font-bold text-[var(--text)]"
            >Standards & Performance:</span
          >
          <span class="text-[var(--muted)] ml-2"
            >Web Content Accessibility Guidelines (WCAG), Web Performance
            Optimization, Responsive Design</span
          >
        </div>
      </div>
    </div>

    <!-- Professional Experience -->
    <div
      class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-colors duration-300"
    >
      <h2
        class="text-2xl font-display font-bold text-[var(--text)] mb-8 flex items-center gap-3"
      >
        Professional experience
      </h2>

      <div class="space-y-12">
        <div class="relative pl-6 border-l-2 border-primary/30 space-y-4">
          <div
            class="absolute w-4 h-4 rounded-full bg-[var(--text)] -left-[9px] top-1 shadow-[0_0_10px_rgba(221,183,255,0.8)]"
          >
          </div>
          <div>
            <h3 class="text-xl font-display font-bold text-[var(--text)]">
              Senior Developer, Cloud Operations
            </h3>
            <div class="flex flex-wrap justify-between text-sm mt-1">
              <span class="text-secondary font-semibold"
                >ITC Infotech (Client: Oona Insurance)</span
              >
              <span class="text-[var(--muted)]"
                >Feb 2025 - Present | Pune, Maharashtra</span
              >
            </div>
          </div>
          <ul
            class="list-disc list-outside ml-4 space-y-2 text-[var(--muted)] text-body-md"
          >
            <li>
              <span class="font-bold text-[var(--text)]">Own</span> technical
              decisions for Cloud Operations across AEM Sites and Assets environments,
              directing a cross-functional team of 3-5 (developers, QA, architects)
              through critical pre-production and production deployments and AWS Dispatcher
              configurations while maintaining <span
                class="font-bold text-[var(--text)]"
                >100% regulatory compliance</span
              > through optimized CloudFront cache and CSP policies.
            </li>
            <li>
              <span class="font-bold text-[var(--text)]">Applied</span> Generative
              AI tooling (GitHub Copilot) to refactor AEM ClientLibs and backend
              processes with less manual work.
            </li>
            <li>
              <span class="font-bold text-[var(--text)]"
                >Evaluated and drove adoption</span
              > of GraphQL persisted queries as the team's data-fetching standard,
              increasing frontend velocity by <span
                class="font-bold text-[var(--text)]">30%</span
              > and reducing friction for frontend developers, cutting data over-fetching
              by <span class="font-bold text-[var(--text)]">70%</span>, and
              accelerating page load speeds by <span
                class="font-bold text-[var(--text)]">50%</span
              > through advanced caching and preloading strategies, contributing to
              improved conversion.
            </li>
            <li>
              <span class="font-bold text-[var(--text)]">Defined and owned</span
              > a structured SCSS architecture standard that cut CSS bundle size by
              <span class="font-bold text-[var(--text)]">40%</span>, and
              improved font load speed by <span
                class="font-bold text-[var(--text)]">50%</span
              > through a site-wide refactor to CSS variables and Google Fonts.
            </li>
            <li>
              <span class="font-bold text-[var(--text)]">Eliminated</span> credential
              leak risk by migrating PromoCodes logic to secure Java servlets, and
              cut manual authoring effort by <span
                class="font-bold text-[var(--text)]">20%</span
              > by revamping component dialogs and templates.
            </li>
            <li>
              <span class="font-bold text-[var(--text)]"
                >Designed Architecture</span
              > and delivered a centralized Resource Center that cut user support
              queries by <span class="font-bold text-[var(--text)]">60%</span>,
              reducing weekly support work. The client adopted it as the primary
              knowledge base for sales teams and agents using the Kahoona portal.
            </li>
          </ul>
        </div>

        <div class="relative pl-6 border-l-2 border-primary/30 space-y-4">
          <div
            class="absolute w-4 h-4 rounded-full bg-[var(--text)]/30 -left-[9px] top-1"
          >
          </div>
          <div>
            <h3 class="text-xl font-display font-bold text-[var(--text)]">
              Associate Consultant
            </h3>
            <div class="flex flex-wrap justify-between text-sm mt-1">
              <span class="text-secondary font-semibold"
                >Capgemini Technology Services (Clients: Vanguard, J.P. Morgan
                and Chase)</span
              >
              <span class="text-[var(--muted)]"
                >Apr 2021 - Feb 2025 | Pune, Maharashtra</span
              >
            </div>
          </div>
          <ul
            class="list-disc list-outside ml-4 space-y-2 text-[var(--muted)] text-body-md"
          >
            <li>
              <span class="font-bold text-[var(--text)]">Built</span> 40+ accessibility-compliant
              AEM components using TypeScript and SCSS, achieving a <span
                class="font-bold text-[var(--text)]"
                >98% client satisfaction</span
              > rate.
            </li>
            <li>
              <span class="font-bold text-[var(--text)]">Led</span> AEM frontend module
              setup across 5+ enterprise projects using Git submodules, and delivered
              10+ Java/Sling backend services supporting complex component functionality.
            </li>
            <li>
              <span class="font-bold text-[var(--text)]">Improved</span> application
              performance by <span class="font-bold text-[var(--text)]"
                >20%</span
              > through SPA-like functionality and cut overall page load times by
              <span class="font-bold text-[var(--text)]">25%</span> via end-to-end
              performance optimization.
            </li>
            <li>
              <span class="font-bold text-[var(--text)]">Increased</span> content
              authoring efficiency by <span class="font-bold text-[var(--text)]"
                >30%</span
              > by designing intuitive custom AEM components for business authors.
            </li>
            <li>
              <span class="font-bold text-[var(--text)]">Established</span> a Storybook
              component library and maintained <span
                class="font-bold text-[var(--text)]"
                >90% automated test coverage</span
              > (Mockito, Jest), contributing to a <span
                class="font-bold text-[var(--text)]">90% reduction</span
              > in new-developer onboarding time.
            </li>
            <li>
              <span class="font-bold text-[var(--text)]">Mentored</span> 5+ junior
              developers on coding standards and best practices while ensuring <span
                class="font-bold text-[var(--text)]">100% on-time</span
              > project delivery.
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Education & Leadership -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div
        class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-colors duration-300"
      >
        <h2
          class="text-2xl font-display font-bold text-[var(--text)] mb-6 flex items-center gap-3"
        >
          Education
        </h2>
        <div class="space-y-4">
          <div>
            <h3 class="text-lg font-bold text-[var(--text)]">
              Bachelor of Engineering in Computer Engineering
            </h3>
            <div class="text-secondary text-sm mt-1">
              University of Mumbai | 2017 - 2020
            </div>
          </div>
          <ul
            class="list-disc list-outside ml-4 space-y-1 text-[var(--muted)] text-body-md"
          >
            <li>Key Project: Physical Intrusion Detection System</li>
            <li>
              Activities: IEEE Committee Volunteer; Organizer, AI and Coding
              Seminars
            </li>
          </ul>
        </div>
      </div>

      <div
        class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-colors duration-300"
      >
        <h2
          class="text-2xl font-display font-bold text-[var(--text)] mb-6 flex items-center gap-3"
        >
          Leadership and competencies
        </h2>
        <div class="flex flex-wrap gap-2">
          {
            [
              "Agile/Scrum Leadership",
              "Technical Architecture",
              "Stakeholder Management",
              "Client Collaboration",
              "Cross-Functional Mentorship",
              "Technical Presentations",
              "Cross-Team Communication",
            ].map((skill) => (
              <span class="px-4 py-2 bg-[var(--panel)] text-[var(--text)] rounded-full text-sm font-display border border-white/5">
                {skill}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Certifications & Specializations -->
    <div
      class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-colors duration-300"
    >
      <h2
        class="text-2xl font-display font-bold text-[var(--text)] mb-6 flex items-center gap-3"
      >
        Certifications and specializations
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          [
            "Adobe Experience Manager Edge Delivery Services - Developer Professional, Adobe (May 2026 - May 2028)",
            "AWS Partner: Generative AI Essentials - Training Badge, Amazon Web Services (June 2026)",
            "AWS Partner: Generative AI Sales - Training Badge, Amazon Web Services (June 2026)",
            "AWS Partner: Technical Accredited - Training Badge, Amazon Web Services (June 2026)",
            "Microservice Architectures, Vanderbilt University (May 2026)",
            "Google AI Essentials Specialization, Google (January 2026)",
            "Cloud Fundamentals, LearnKartS (February 2026)",
          ].map((cert) => (
            <li class="flex items-start gap-3">
              <span class="text-[var(--muted)] text-body-md">{cert}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Download CTA -->
    <div class="flex justify-center pt-8">
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="button resume-download"
      >
        Download PDF <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>
