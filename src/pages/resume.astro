---
import Layout from '../layouts/Layout.astro';

const title = "Suyog Mule - Resume | AEM Full-Stack Developer";
const description = "Professional resume of Suyog Mule, AEM Full-Stack Developer.";
---

<Layout title={title} description={description}>
  <section class="max-w-[1000px] mx-auto px-6 py-16 md:py-24 space-y-16">
    <!-- Header -->
    <div class="text-center space-y-4 relative">
      <div class="absolute inset-0 bg-primary/10 blur-[100px] rounded-full pointer-events-none"></div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-on-surface">SUYOG MULE</h1>
      <p class="text-primary font-display font-semibold text-lg md:text-xl tracking-wider">AEM Full Stack Developer | Cloud Operations | AI-Driven Modernization</p>
      <div class="flex flex-wrap justify-center gap-4 text-sm text-on-surface-variant font-sans">
        <span>Pune, Maharashtra</span>
        <span class="hidden md:inline">&bull;</span>
        <span>smulye10@gmail.com</span>
        <span class="hidden md:inline">&bull;</span>
        <span>+91 88881 86744</span>
        <span class="hidden md:inline">&bull;</span>
        <a href="https://linkedin.com/in/akio333" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">linkedin.com/in/akio333</a>
      </div>
    </div>

    <!-- Professional Summary -->
    <div class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-all duration-300">
      <h2 class="text-2xl font-display font-bold text-on-surface mb-4 flex items-center gap-3">
        <span class="material-symbols-outlined text-primary" aria-hidden="true">person</span>
        Professional Summary
      </h2>
      <p class="text-on-surface-variant leading-relaxed text-body-md">
        Results-driven AEM Full Stack Developer with 5+ years of experience architecting, building, and optimizing enterprise Adobe Experience Manager (AEM), React, and TypeScript solutions across cloud environments. Owns end-to-end technical decision-making for AEM Cloud Operations, directing a 3-5 person cross-functional engineering team and driving GraphQL-based performance gains of up to 30%, a 40% reduction in CSS bundle size, and measurable business outcomes such as improved conversion and weekly support-hour savings. Skilled at applying Generative AI tools (GitHub Copilot) to accelerate code refactoring and technical upgrades. Combines hands-on technical leadership with WCAG-compliant, accessibility-first delivery and client-facing collaboration that has earned formal recognition from enterprise clients.
      </p>
    </div>

    <!-- Core Technical Skills -->
    <div class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-all duration-300">
      <h2 class="text-2xl font-display font-bold text-on-surface mb-6 flex items-center gap-3">
        <span class="material-symbols-outlined text-primary" aria-hidden="true">code</span>
        Core Technical Skills
      </h2>
      <div class="space-y-4">
        <div>
          <span class="font-bold text-on-surface">AEM & Content Management:</span>
          <span class="text-on-surface-variant ml-2">AEM as a Cloud Service (AEMaaCS), AEM 6.5, Touch UI, Multi-Site Manager (MSM), Digital Asset Management (DAM), Content Fragments, Experience Fragments</span>
        </div>
        <div>
          <span class="font-bold text-on-surface">Backend & Architecture:</span>
          <span class="text-on-surface-variant ml-2">Java, J2EE, OSGi (Declarative Services), Apache Sling, JCR (Apache Oak), HTL/Sightly, Sling Models</span>
        </div>
        <div>
          <span class="font-bold text-on-surface">Frontend Development:</span>
          <span class="text-on-surface-variant ml-2">React, TypeScript, JavaScript (ES6+), Angular, HTML5, CSS3, SASS/SCSS, Material UI, Bootstrap, jQuery, Storybook</span>
        </div>
        <div>
          <span class="font-bold text-on-surface">Integrations & DevOps:</span>
          <span class="text-on-surface-variant ml-2">Adobe Target, Adobe Analytics, Dispatcher Configuration, AWS, Maven, CI/CD (Jenkins, GitHub Actions)</span>
        </div>
        <div>
          <span class="font-bold text-on-surface">AI & Developer Tooling:</span>
          <span class="text-on-surface-variant ml-2">GitHub Copilot, Generative AI for Code Refactoring & Legacy Upgrades, Git, Git Submodules, VS Code, IntelliJ IDEA, WebStorm</span>
        </div>
        <div>
          <span class="font-bold text-on-surface">Testing & Quality:</span>
          <span class="text-on-surface-variant ml-2">Jest, Mockito, Percy, BrowserStack, Unit & Regression Testing</span>
        </div>
        <div>
          <span class="font-bold text-on-surface">Standards & Performance:</span>
          <span class="text-on-surface-variant ml-2">Web Content Accessibility Guidelines (WCAG), Web Performance Optimization, Responsive Design</span>
        </div>
      </div>
    </div>

    <!-- Professional Experience -->
    <div class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-all duration-300">
      <h2 class="text-2xl font-display font-bold text-on-surface mb-8 flex items-center gap-3">
        <span class="material-symbols-outlined text-primary" aria-hidden="true">work</span>
        Professional Experience
      </h2>
      
      <div class="space-y-12">
        <div class="relative pl-6 border-l-2 border-primary/30 space-y-4">
          <div class="absolute w-4 h-4 rounded-full bg-primary -left-[9px] top-1 shadow-[0_0_10px_rgba(221,183,255,0.8)]"></div>
          <div>
            <h3 class="text-xl font-display font-bold text-on-surface">Senior Developer, Cloud Operations</h3>
            <div class="flex flex-wrap justify-between text-sm mt-1">
              <span class="text-secondary font-semibold">ITC Infotech (Client: Oona Insurance)</span>
              <span class="text-on-surface-variant">Feb 2025 &ndash; Present | Pune, Maharashtra</span>
            </div>
          </div>
          <ul class="list-disc list-outside ml-4 space-y-2 text-on-surface-variant text-body-md">
            <li><span class="font-bold text-on-surface">Own</span> end-to-end technical decision-making for Cloud Operations across AEM Sites and Assets environments, directing a cross-functional team of 3-5 (developers, QA, architects) through critical pre-production and production deployments and AWS Dispatcher configurations while maintaining <span class="font-bold text-on-surface">100% regulatory compliance</span> through optimized CloudFront cache and CSP policies.</li>
            <li><span class="font-bold text-on-surface">Applied</span> Generative AI tooling (GitHub Copilot) to drive major code refactors, streamlining AEM ClientLibs and backend processes and reducing manual engineering effort.</li>
            <li><span class="font-bold text-on-surface">Evaluated and drove adoption</span> of GraphQL persisted queries as the team's data-fetching standard, boosting frontend velocity by <span class="font-bold text-on-surface">30%</span> and reducing friction for frontend developers, cutting data over-fetching by <span class="font-bold text-on-surface">70%</span>, and accelerating page load speeds by <span class="font-bold text-on-surface">50%</span> through advanced caching and preloading strategies &mdash; contributing to improved conversion.</li>
            <li><span class="font-bold text-on-surface">Defined and owned</span> a structured SCSS architecture standard that cut CSS bundle size by <span class="font-bold text-on-surface">40%</span>, and improved font load speed by <span class="font-bold text-on-surface">50%</span> through a site-wide refactor to CSS variables and Google Fonts.</li>
            <li><span class="font-bold text-on-surface">Eliminated</span> credential leak risk by migrating PromoCodes logic to secure Java servlets, and cut manual authoring effort by <span class="font-bold text-on-surface">20%</span> by revamping component dialogs and templates.</li>
            <li><span class="font-bold text-on-surface">Designed Architecture</span> and delivered a centralized Resource Center that cut user support queries by <span class="font-bold text-on-surface">60%</span>, saving the support team significant hours weekly; formally recognized by the client as the primary knowledge base for Sales and Agents issuing policies through the Kahoona portal.</li>
          </ul>
        </div>

        <div class="relative pl-6 border-l-2 border-primary/30 space-y-4">
          <div class="absolute w-4 h-4 rounded-full bg-primary/30 -left-[9px] top-1"></div>
          <div>
            <h3 class="text-xl font-display font-bold text-on-surface">Associate Consultant</h3>
            <div class="flex flex-wrap justify-between text-sm mt-1">
              <span class="text-secondary font-semibold">Capgemini Technology Services (Clients: Vanguard, J.P. Morgan and Chase)</span>
              <span class="text-on-surface-variant">Apr 2021 &ndash; Feb 2025 | Pune, Maharashtra</span>
            </div>
          </div>
          <ul class="list-disc list-outside ml-4 space-y-2 text-on-surface-variant text-body-md">
            <li><span class="font-bold text-on-surface">Built</span> 40+ accessibility-compliant AEM components using TypeScript and SCSS, achieving a <span class="font-bold text-on-surface">98% client satisfaction</span> rate.</li>
            <li><span class="font-bold text-on-surface">Led</span> AEM frontend module setup across 5+ enterprise projects using Git submodules, and delivered 10+ Java/Sling backend services supporting complex component functionality.</li>
            <li><span class="font-bold text-on-surface">Improved</span> application performance by <span class="font-bold text-on-surface">20%</span> through SPA-like functionality and cut overall page load times by <span class="font-bold text-on-surface">25%</span> via end-to-end performance optimization.</li>
            <li><span class="font-bold text-on-surface">Increased</span> content authoring efficiency by <span class="font-bold text-on-surface">30%</span> by designing intuitive custom AEM components for business authors.</li>
            <li><span class="font-bold text-on-surface">Established</span> a Storybook component library and maintained <span class="font-bold text-on-surface">90% automated test coverage</span> (Mockito, Jest), contributing to a <span class="font-bold text-on-surface">90% reduction</span> in new-developer onboarding time.</li>
            <li><span class="font-bold text-on-surface">Mentored</span> 5+ junior developers on coding standards and best practices while ensuring <span class="font-bold text-on-surface">100% on-time</span> project delivery.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Education & Leadership -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-all duration-300">
        <h2 class="text-2xl font-display font-bold text-on-surface mb-6 flex items-center gap-3">
          <span class="material-symbols-outlined text-primary" aria-hidden="true">school</span>
          Education
        </h2>
        <div class="space-y-4">
          <div>
            <h3 class="text-lg font-bold text-on-surface">Bachelor of Engineering in Computer Engineering</h3>
            <div class="text-secondary text-sm mt-1">University of Mumbai | 2017 &ndash; 2020</div>
          </div>
          <ul class="list-disc list-outside ml-4 space-y-1 text-on-surface-variant text-body-md">
            <li>Key Project: Physical Intrusion Detection System</li>
            <li>Activities: IEEE Committee Volunteer; Organizer, AI and Coding Seminars</li>
          </ul>
        </div>
      </div>

      <div class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-all duration-300">
        <h2 class="text-2xl font-display font-bold text-on-surface mb-6 flex items-center gap-3">
          <span class="material-symbols-outlined text-primary" aria-hidden="true">psychology</span>
          Leadership & Competencies
        </h2>
        <div class="flex flex-wrap gap-2">
          {["Agile/Scrum Leadership", "Technical Architecture", "Stakeholder Management", "Client Collaboration", "Cross-Functional Mentorship", "Technical Presentations", "Cross-Team Communication"].map((skill) => (
            <span class="px-4 py-2 bg-surface-container-high text-on-surface rounded-full text-sm font-display border border-white/5">{skill}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Certifications & Specializations -->
    <div class="glass-surface p-8 md:p-10 rounded-2xl border border-white/10 group hover:border-primary/30 transition-all duration-300">
      <h2 class="text-2xl font-display font-bold text-on-surface mb-6 flex items-center gap-3">
        <span class="material-symbols-outlined text-primary" aria-hidden="true">verified</span>
        Certifications & Specializations
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {[
          "Adobe Experience Manager Edge Delivery Services – Developer Professional, Adobe (May 2026 – May 2028)",
          "AWS Partner: Generative AI Essentials – Training Badge, Amazon Web Services (June 2026)",
          "AWS Partner: Generative AI Sales – Training Badge, Amazon Web Services (June 2026)",
          "AWS Partner: Technical Accredited – Training Badge, Amazon Web Services (June 2026)",
          "Microservice Architectures, Vanderbilt University (May 2026)",
          "Google AI Essentials Specialization, Google (January 2026)",
          "Cloud Fundamentals, LearnKartS (February 2026)"
        ].map((cert) => (
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-xl mt-0.5" aria-hidden="true">workspace_premium</span>
            <span class="text-on-surface-variant text-body-md">{cert}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Download CTA -->
    <div class="flex justify-center pt-8">
      <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-primary text-on-primary font-bold rounded-lg hover:scale-105 transition-transform flex items-center justify-center gap-2 shadow-[0_0_25px_rgba(221,183,255,0.3)] border border-primary/25 cursor-pointer">
        <span class="material-symbols-outlined" aria-hidden="true">download</span>
        Download PDF Version
      </a>
    </div>

  </section>
</Layout>
