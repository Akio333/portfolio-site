---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Experience | Suyog Mule"
  description="My development experience at ITC Infotech and Capgemini, building AEM platforms for insurance, banking, and investment teams."
>
  <section class="page-heading wrap">
    <h1 class="enter">Experience<span class="accent">.</span></h1>
  </section>
  <section class="timeline wrap" aria-label="Work experience">
    {
      experience.map((item) => (
        <article class="experience-row" data-reveal>
          <>
            <div>
              <>
                <p class="experience-period">
                  {item.data.period}
                </p>
                <h2>{item.data.company}</h2>
              </>
            </div>
            <div>
              <>
                <h3>{item.data.role}</h3>
                <p>{item.data.description}</p>
                <div class="tags">
                  {item.data.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              </>
            </div>
          </>
        </article>
      ))
    }
  </section>
  <section class="resume-section wrap" data-reveal>
    <h2>Need the full record?</h2><a
      class="button"
      href="/resume"
      rel="noopener">View my résumé <span aria-hidden="true">↗</span></a
    >
  </section>
</Layout>
